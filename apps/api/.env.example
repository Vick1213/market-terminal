# Market Terminal API — environment template.
# Copy to .env (gitignored) and fill in what you use:  cp .env.example .env
# Every key is OPTIONAL — the terminal is keyless by design and degrades
# gracefully: a missing key disables that one leg, nothing else breaks.

# --- FRED (recommended) ------------------------------------------------------
# Free key at https://fred.stlouisfed.org/docs/api/api_key.html
# Powers the FRED macro leg (composite inputs, yields, spreads) and the
# CPI/NFP/PPI/GDP/PCE release calendar. Without it the FRED ingestor is
# disabled and only NFP dates are estimated.
MARKET_FRED_API_KEY=

# --- LLM narratives (brief + strategist) -------------------------------------
# Provider for the morning-brief and strategist notes. Default is "ollama"
# (local, private, $0 tokens — uses MARKET_OLLAMA_* below, no key needed).
# Cloud providers send your terminal's digest off-machine — privacy trade-off.
# Any failure falls back to the deterministic template; never silently fails.
#   ollama | openai | deepseek | anthropic
MARKET_LLM_PROVIDER=ollama
# API key for openai / deepseek / anthropic (unused by ollama).
MARKET_LLM_API_KEY=
# Model override. Empty = per-provider default:
#   ollama: qwen3:8b · openai: gpt-4o-mini · deepseek: deepseek-chat
#   anthropic: claude-opus-4-8
MARKET_LLM_MODEL=
# Base-URL override, e.g. a self-hosted OpenAI-compatible server
# (defaults: api.openai.com/v1, api.deepseek.com/v1, api.anthropic.com).
MARKET_LLM_BASE_URL=
MARKET_LLM_TIMEOUT_SECONDS=180

# Local Ollama (used when MARKET_LLM_PROVIDER=ollama).
MARKET_OLLAMA_URL=http://127.0.0.1:11434
MARKET_OLLAMA_MODEL=qwen3:8b

# --- Phone push (ntfy.sh) -----------------------------------------------------
# Not a real key: any LONG RANDOM string (it is the only auth — make it
# unguessable). Subscribe to the same topic in the ntfy app; warn/critical
# alerts + the morning brief then push to your phone. Empty = in-app only.
MARKET_NTFY_TOPIC=
MARKET_NTFY_SERVER=https://ntfy.sh

# --- Finnhub (optional news source) -------------------------------------------
# Free tier at https://finnhub.io (60 calls/min). Adds per-ticker company
# news; Yahoo RSS + EDGAR + broad feeds run regardless.
MARKET_FINNHUB_API_KEY=

# --- Identity ------------------------------------------------------------------
# Baked into the global User-Agent; SEC EDGAR REQUIRES a contact address.
MARKET_CONTACT_EMAIL=you@example.com
