# --- data & local state (never commit) ---
/data/
# M3: settings.json (BYO API keys/credentials) — separate dir from /data/
# above (see app/settings_store.py), never committed either way.
/apps/api/data/
*.duckdb
*.duckdb.wal
*.db
*.db-wal
*.db-shm
.cache/
.diskcache/

# --- python ---
__pycache__/
*.py[cod]
.venv/
apps/api/.venv/
.python-version.local

# --- node / next ---
node_modules/
.next/
out/
dist/
.turbo/
*.tsbuildinfo

# --- desktop sidecar build (PyInstaller onedir; M2 packaging) ---
# `dist/` above already covers apps/api/dist/, but be explicit since that's
# the actual PyInstaller output dir; `build/` is PyInstaller's intermediate
# working dir (never the output). The staged copy Tauri bundles from is
# regenerated by apps/desktop/scripts/build-sidecar.mjs — never commit it,
# it's ~600MB with torch and is per-platform/per-arch.
/apps/api/build/
/apps/api/dist/
/apps/desktop/src-tauri/sidecar/

# --- env & secrets ---
.env
.env.local
.env.*.local
apps/web/.env.local
apps/api/.env

# --- editor / os ---
.DS_Store
.vscode/
.idea/
*.log

# --- session scratch & generated output (never commit) ---
/scratchpad/
/brag-output/
/brag-output-*/
.claude/settings.local.json
