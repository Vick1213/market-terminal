# Copy to .env (backend) and apps/web/.env.local (frontend) as needed.

# --- backend (apps/api) ---
# Descriptive User-Agent is REQUIRED by SEC EDGAR and good practice everywhere.
MARKET_CONTACT_EMAIL=saatvik1213@gmail.com
# Override where DuckDB/SQLite files live (defaults to <repo>/data).
# MARKET_DATA_DIR=/Users/saatvik1213/Documents/market/data
MARKET_HEARTBEAT_SECONDS=5

# --- Phase 1: sentiment + news ---
# Optional Finnhub key (free at finnhub.io). Empty -> Finnhub ingestor disabled,
# Yahoo RSS + SEC EDGAR still run.
MARKET_FINNHUB_API_KEY=
# FinBERT + distilroberta ensemble (off by default; doubles model RAM/load).
MARKET_SENTIMENT_ENSEMBLE=false
# Force inference device ("mps" | "cpu"); empty = auto-detect MPS.
MARKET_SENTIMENT_DEVICE=
# News poll cadences (minutes).
MARKET_NEWS_POLL_MINUTES=10
MARKET_EDGAR_POLL_MINUTES=10
MARKET_EDGAR_LOOKBACK_DAYS=7
# GDELT macro-theme rotation + broad CNBC/MarketWatch/Investing topic feeds.
MARKET_GDELT_POLL_MINUTES=15
MARKET_BROAD_RSS_POLL_MINUTES=5

# --- frontend (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# --- Phase 2: macro / liquidity + regime ---
# Optional FRED key (free at fred.stlouisfed.org/docs/api/api_key.html).
# Empty -> keyless fredgraph.csv endpoint is used (same data).
MARKET_FRED_API_KEY=
# Daily-ish sources (minutes); NAAIM/AAII are weekly prints.
MARKET_FRED_POLL_MINUTES=360
MARKET_CBOE_POLL_MINUTES=360
MARKET_FINRA_POLL_MINUTES=360
MARKET_NAAIM_POLL_MINUTES=720
MARKET_AAII_POLL_MINUTES=720
MARKET_COMPOSITE_POLL_MINUTES=60

# --- Phase 5: retail market score ---
# ApeWisdom filters to merge (JSON list; all-stocks + all-crypto cover the
# board without double-counting).
MARKET_APEWISDOM_FILTERS=["all-stocks","all-crypto"]
MARKET_APEWISDOM_PAGES=2
# ApeWisdom updates ~2x/hr server-side.
MARKET_APEWISDOM_POLL_MINUTES=20
# StockTwits/Bluesky text polls cover only the top spiking tickers.
MARKET_RETAIL_SOCIAL_POLL_MINUTES=30
MARKET_RETAIL_SPIKE_TOP_N=8
MARKET_RETAIL_MESSAGE_RETENTION_DAYS=14
# Tradestie WSB cross-confirmation (Cloudflare-gated; skip-on-fail).
MARKET_TRADESTIE_POLL_MINUTES=30

# --- Phase 11: Alpaca market data (price redundancy + live quotes) ---
# Free keys (no funded account) from app.alpaca.markets. Empty -> yfinance is
# the sole price source. These power live watchlist quotes + a daily-bar fallback.
MARKET_ALPACA_KEY_ID=
MARKET_ALPACA_SECRET_KEY=

# --- Phase 12: paper trading bot (strategist proposal surface) ---
# The bot turns the strategist's suggested allocation into Alpaca PAPER orders
# behind hard, code-enforced guardrails. It is OFF by default (kill switch),
# proposal-only by default, and CANNOT trade live unless you flip the gate below.
#
# Trading uses the PAPER endpoint + (usually) a PAPER key pair, which is
# DIFFERENT from the data keys above. The data API takes either key; the paper
# trading API only accepts paper-account keys. If your MARKET_ALPACA_* keys are
# paper keys, leave these blank to reuse them; otherwise set your paper pair:
MARKET_ALPACA_PAPER_KEY_ID=
MARKET_ALPACA_PAPER_SECRET_KEY=
# Paper endpoint. Do not change unless you know exactly what you are doing.
MARKET_ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
# HARD SAFETY GATE — leave false. True lets the broker trade a non-paper URL.
MARKET_BOT_ALLOW_LIVE_TRADING=false
# First-boot defaults (runtime kill switch + mode persist in the DB).
MARKET_BOT_ENABLED_DEFAULT=false
MARKET_BOT_MODE_DEFAULT=proposal
# Guardrails (cannot be widened from the API at runtime).
MARKET_BOT_MAX_POSITION_PCT=15
MARKET_BOT_MAX_POSITION_NOTIONAL=5000
MARKET_BOT_MIN_ORDER_NOTIONAL=100
MARKET_BOT_DAILY_LOSS_LIMIT_PCT=3
MARKET_BOT_REBALANCE_BAND_PP=2
